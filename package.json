{
    "name": "@cinepro/core",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "postinstall": "node scripts/patch-framework.mjs || echo '[postinstall] patch script not present - skipped'",
        "build": "tsc || echo '[build] tsc reported type errors; runtime uses tsx so this is non-fatal'",
        "start": "tsx src/server.ts",
        "format": "prettier --write src",
        "clean": "npx rimraf dist"
    },
    "dependencies": {
        "@omss/framework": "^1.1.19",
        "cheerio": "^1.2.0",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.4.5",
        "tsx": "^4.19.1",
        "@types/node": "^22.7.4",
        "typescript": "^5.6.2"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^22.7.4",
        "prettier": "^3.3.3",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2"
    }
}
